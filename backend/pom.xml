<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>dev.pppp</groupId>
    <artifactId>pppp-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>pppp</name>
    <description>Pibs&amp;PibettesPlayPokemon backend</description>

    <modules>
        <module>pppp-emulator</module>
        <module>pppp-core</module>
        <module>pppp-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <coffeegb.version>2.1.8</coffeegb.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.pppp</groupId>
                <artifactId>pppp-emulator</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.pppp</groupId>
                <artifactId>pppp-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.rekawek.coffeegb</groupId>
                <artifactId>core</artifactId>
                <version>${coffeegb.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
